EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Sentry (projeto react-native em sentry.io/organizations/confraria)
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=confraria
SENTRY_PROJECT=react-native
# Token para upload de source maps no EAS Build (não commitar)
SENTRY_AUTH_TOKEN=

# Login Social — Google (Client IDs do Google Cloud > OAuth)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# iOS URL scheme = o iOS client id invertido (com.googleusercontent.apps.xxxx)
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Login Social — Facebook / Meta (Meta for Developers)
EXPO_PUBLIC_FACEBOOK_APP_ID=
EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=
